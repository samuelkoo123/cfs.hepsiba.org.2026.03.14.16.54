{
  "entities": {
    "Church": {
      "title": "Church",
      "description": "A church registration in the system",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the church" },
        "password": { "type": "string", "description": "Hashed password for the church" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the church was registered" }
      },
      "required": ["name", "password", "createdAt"]
    },
    "Member": {
      "title": "Member",
      "description": "A member of a church",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "birthDate": { "type": "string" },
        "registrationDate": { "type": "string" }
      },
      "required": ["name"]
    },
    "Offering": {
      "title": "Offering",
      "description": "An offering record",
      "type": "object",
      "properties": {
        "memberId": { "type": "string", "description": "ID of the member who gave the offering" },
        "type": { "type": "string", "description": "Type of offering (e.g., Tithe, Sunday)" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["type", "amount", "date"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction (income/expense)",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "memberId": { "type": "string", "description": "Optional member ID associated with the transaction" }
      },
      "required": ["type", "category", "amount", "date"]
    }
  },
  "firestore": {
    "/churches": {
      "schema": "Church",
      "description": "Collection of registered churches"
    },
    "/churches/{churchId}/members": {
      "schema": "Member",
      "description": "Members belonging to a specific church"
    },
    "/churches/{churchId}/offerings": {
      "schema": "Offering",
      "description": "Offerings recorded for a specific church"
    },
    "/churches/{churchId}/transactions": {
      "schema": "Transaction",
      "description": "Transactions recorded for a specific church"
    }
  }
}
